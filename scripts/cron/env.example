# 复制到 ~/.config/open-company/env 并 chmod 600。不要提交到仓库。
# Kiro CLI headless 模式的 API key
KIRO_API_KEY=
# 值班任务盯的仓库(不填默认 chaxiu/OpenCompare)
GITHUB_REPO=aadnapp/open-company
# 对外回帖所用账号的 GitHub token(fine-grained,只授权 GITHUB_REPO 一个仓库)
GH_TOKEN=
# node >= 18 所在目录(系统自带 node 太旧时必填)
NODE_DIR=/home/whole/.nvm/versions/node/v24.16.0/bin
# 可选:kiro-cli 路径与工具授权参数
# KIRO_CLI=/home/whole/.local/bin/kiro-cli
# KIRO_TRUST_FLAGS="--trust-all-tools --trust-workspace"
